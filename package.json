{
  "name": "doomscrolling_plot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "test": "tsx --test tests/**/*.test.ts",
        "crawler:local": "npm run build && node --env-file=.env.local dist/index.js",
        "migrate:snapshots": "tsx src/migrateSnapshots.ts",
    "migrate:diffs": "tsx src/migrateDiffs.ts",
    "migrate:reviewed-diffs": "tsx src/migrateReviewedDiffs.ts",
    "dev": "tsx src/server.ts & server_pid=$!; trap 'kill \"$server_pid\" 2>/dev/null; wait \"$server_pid\" 2>/dev/null' EXIT INT TERM; npm --prefix ui run dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "cheerio": "^1.1.2",
    "diff": "^8.0.2",
    "firebase-admin": "^14.2.0",
    "fs": "^0.0.1-security",
    "hono": "^4.12.11",
    "playwright": "^1.57.0",
    "undici": "^7.18.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
