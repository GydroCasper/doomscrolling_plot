[
  {
    "id": "mortgage-rates-mnd",
    "url": "https://www.mortgagenewsdaily.com/mortgage-rates/mnd",
    "match": {
      "selector": "table.mtg-rates tbody tr:contains('30 Yr. Fixed') th, table.mtg-rates tbody tr:contains('30 Yr. Fixed') td:first-of-type, table.mtg-rates tbody tr:contains('15 Yr. Fixed') th, table.mtg-rates tbody tr:contains('15 Yr. Fixed') td:first-of-type, table.mtg-rates tbody tr:contains('SOFR') th, table.mtg-rates tbody tr:contains('SOFR') td:first-of-type",
      "extract": "text"
    }
  },
  {
    "id": "boa-mortgage-rates",
    "url": "https://www.bankofamerica.com/home-loans-sales/getProductRates",
    "method": "POST",
    "body": {
      "rateInputs": {
        "purchasePrice": 800000,
        "amountBorrowed": 600000,
        "postalCode": "02117",
        "ficoScore": 740,
        "lockPeriod": 60,
        "financeType": 2,
        "branchCode": "3018",
        "downPayment": 200000
      },
      "mortgageProducts": [
        { "productCode": 3, "productSubCode": "360", "productName": "Fixed 30 Years" },
        { "productCode": 1, "productSubCode": "180", "productName": "Fixed 15 Years" },
        { "productCode": 1698, "productSubCode": "360", "productName": "ARM Fixed First 5 Years, Then Adjusts Every 6 Months" }
      ]
    },
    "match": {
      "extract": "json",
      "jsonPath": "mortgageProducts[*].{productName,rateDetails.rate}"
    }
  },
  {
